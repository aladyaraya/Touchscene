<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/connectionFragment">
    <fragment android:id="@+id/connectionFragment"
        android:name="com.insta360.kmpsdk.demo.phonecamera.PhoneConnectionFragment"
        android:label="@string/nav_connection"
        tools:layout="@layout/fragment_connection">
        <action android:id="@+id/action_connectionFragment_to_previewFragment"
            app:destination="@id/previewFragment" />
        <action android:id="@+id/action_connectionFragment_to_localImageRecognitionFragment"
            app:destination="@id/localImageRecognitionFragment" />
    </fragment>
    <fragment android:id="@+id/previewFragment"
        android:name="com.insta360.kmpsdk.demo.ui.capture.PreviewFragment"
        android:label="拍摄（预览）" tools:layout="@layout/fragment_preview" />
    <fragment android:id="@+id/localImageRecognitionFragment"
        android:name="com.insta360.kmpsdk.demo.ui.localimage.LocalImageRecognitionFragment"
        android:label="@string/touchscene_local_image_page_title"
        tools:layout="@layout/fragment_local_image_recognition" />
</navigation>

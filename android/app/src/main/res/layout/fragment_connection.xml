<?xml version="1.0" encoding="utf-8"?>
<com.insta360.kmpsdk.demo.widget.GestureAwareNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/connection_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/touchscene_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wifi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/touchscene_primary"
            android:contentDescription="@string/unified_home_camera"
            android:text="@string/unified_home_camera"
            android:textColor="@color/touchscene_bg"
            android:textSize="30sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:rippleColor="#80FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_local_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/touchscene_card_bg"
            android:contentDescription="@string/unified_home_image"
            android:text="@string/unified_home_image"
            android:textColor="@color/touchscene_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:rippleColor="#8000E5FF"
            app:strokeColor="@color/touchscene_primary"
            app:strokeWidth="2dp" />

        <!-- Preserved binding/test IDs only; no extra visible or accessibility-focusable targets. -->
        <LinearLayout android:id="@+id/hidden_compat_layout" android:layout_width="match_parent" android:layout_height="0dp"
            android:orientation="vertical" android:visibility="gone" android:importantForAccessibility="noHideDescendants">
            <LinearLayout android:id="@+id/header_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/hero_connect_card" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <ImageView android:id="@+id/status_indicator_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@null" />
            <TextView android:id="@+id/status_text" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/connection_result" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/disconnect_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_scan" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_usb" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/scan_recycler" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/entry_touchscene_local_demo" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/device_info_card" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton android:id="@+id/refresh_dynamic_btn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/camera_model" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/battery_level" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/charging_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sd_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/camera_sn" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/firmware_version" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/activate_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sd_total" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/sd_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/internal_total" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/internal_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/internal_status" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/camera_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <LinearLayout android:id="@+id/entry_capture_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/entry_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <com.google.android.material.button.MaterialButton android:id="@+id/entry_no_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <com.google.android.material.button.MaterialButton android:id="@+id/entry_live_stream" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.insta360.kmpsdk.demo.widget.GestureAwareNestedScrollView>
